{
  "openapi": "3.1.0",
  "info": {
    "title": "API de Trámites Clínicos — Centro Médico GastroSalud",
    "description": "API RESTful que expone de forma segura y controlada el servicio de consulta y solicitud de trámites médico-administrativos (autorizaciones de EDA, colonoscopias, informes firmados y certificados) del sistema heredado Linux/MySQL del Centro Médico de Especialidades Gastroenterológicas del Ecuador (GastroSalud Cía. Ltda.). Cumple con LOPDP (2021) y el Acuerdo Ministerial 5216 del MSP. Elaborado por el Grupo 1 (UBE).",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Estado"
        ],
        "summary": "Estado Servicio",
        "description": "Verifica que la API de GastroSalud está en línea (health check para Azure Application Gateway / AKS).",
        "operationId": "estado_servicio__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/token": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Obtener Token",
        "description": "Recibe usuario y contraseña del paciente y devuelve un token JWT firmado (HS256).",
        "operationId": "obtener_token_api_v1_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_obtener_token_api_v1_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tramites": {
      "get": {
        "tags": [
          "Trámites"
        ],
        "summary": "Listar Tramites",
        "description": "Lista los trámites clínico-administrativos del paciente autenticado.",
        "operationId": "listar_tramites_api_v1_tramites_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Tramite"
                  },
                  "type": "array",
                  "title": "Response Listar Tramites Api V1 Tramites Get"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "Trámites"
        ],
        "summary": "Registrar Tramite",
        "description": "Registra una nueva solicitud de trámite clínico a nombre del paciente autenticado.",
        "operationId": "registrar_tramite_api_v1_tramites_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TramiteNuevo"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tramite"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/api/v1/tramites/{tramite_id}": {
      "get": {
        "tags": [
          "Trámites"
        ],
        "summary": "Consultar Tramite",
        "description": "Consulta el estado de un trámite clínico del paciente autenticado.",
        "operationId": "consultar_tramite_api_v1_tramites__tramite_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tramite_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Tramite Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tramite"
                }
              }
            }
          },
          "404": {
            "description": "Trámite no encontrado"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_obtener_token_api_v1_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_obtener_token_api_v1_token_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Token": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "Token"
      },
      "Tramite": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "tipo": {
            "type": "string",
            "title": "Tipo"
          },
          "especialidad": {
            "type": "string",
            "title": "Especialidad",
            "default": "Gastroenterología Clínica"
          },
          "estado": {
            "type": "string",
            "title": "Estado"
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "title": "Fecha"
          }
        },
        "type": "object",
        "required": [
          "id",
          "tipo",
          "estado",
          "fecha"
        ],
        "title": "Tramite"
      },
      "TramiteNuevo": {
        "properties": {
          "tipo": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Tipo",
            "examples": [
              "Solicitud de Informe Firmado de Endoscopia Digestiva Alta (EDA)"
            ]
          },
          "especialidad": {
            "type": "string",
            "maxLength": 80,
            "minLength": 3,
            "title": "Especialidad",
            "default": "Gastroenterología Clínica",
            "examples": [
              "Gastroenterología Clínica"
            ]
          }
        },
        "type": "object",
        "required": [
          "tipo"
        ],
        "title": "TramiteNuevo"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/api/v1/token"
          }
        }
      }
    }
  }
}